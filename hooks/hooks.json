{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/run-brain-hook.js\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\bin\\run-brain-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/run-brain-hook.js\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\bin\\run-brain-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/run-brain-hook.js\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\bin\\run-brain-hook.js\"",
            "timeout": 130
          }
        ]
      }
    ]
  }
}
