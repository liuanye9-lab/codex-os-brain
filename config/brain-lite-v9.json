{
  "version": 9,
  "policyVersion": "brain-v11-personal-reliability",
  "enabled": true,
  "fallbackVersion": 8,
  "hooks": {
    "enabled": false,
    "projectScoped": true,
    "silentByDefault": true,
    "preToolUseBudgetMs": 100,
    "postToolUseBudgetMs": 150,
    "contextTokenBudget": 250
  },
  "failureCircuit": {
    "warningAfter": 2,
    "openAfter": 3
  },
  "verification": {
    "requireHarnessReRun": true,
    "agentClaimsAreUnverified": true
  },
  "handoff": {
    "enabled": true,
    "dir": ".brain",
    "requireSmokeBeforeNewFeature": true
  },
  "skills": {
    "requireExpectedCriteria": true,
    "outputsAreEvidenceCandidates": true
  },
  "hosts": {
    "default": "codex",
    "supported": [
      "codex",
      "claude",
      "generic-mcp"
    ]
  },
  "migration": {
    "mode": "copy",
    "preserveVersions": [
      1,
      2,
      3,
      4,
      5,
      6,
      7,
      8
    ],
    "requireVerifiedBackup": true,
    "requireExplicitConfirmation": true
  },
  "privacy": {
    "storeRawPrompts": false,
    "storeRawToolOutput": false,
    "storePrivatePaths": false
  },
  "activeHooks": [
    "SessionStart",
    "PreToolUse",
    "Stop"
  ],
  "recall": {
    "owner": "codex_native_memories",
    "selfManagedRecall": false
  }
}
