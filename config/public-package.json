{
  "name": "codex-brain-v9",
  "version": "0.17.0",
  "description": "Codex Brain V11 personal reliability harness: three hooks, signed task contracts, and verified completion. Recall is delegated to Codex native memories.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core.js"
  },
  "codexBrain": {
    "productName": "Codex Brain",
    "productMajor": 11,
    "releaseVersion": "0.17.0",
