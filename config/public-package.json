{
  "name": "codex-brain-v9",
  "version": "0.16.0",
  "description": "Codex Brain V10 cognitive asset harness with candidate-gated evidence, project hooks, CLI, and read-only MCP projections.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "license": "MIT",
  "engines": { "node": ">=22.5" },
  "bin": {
    "brain": "bin/brain.js",
    "codex-brain": "bin/brain.js"
  },
  "files": [
    "index.js",
    "bin/brain.js",
    "bin/brain-hook.js",
    "bin/run-brain-hook.js",
    "bin/package.json",
    "config/brain-lite-v9.json",
    "config/embedding-model-presets.json",
    "config/public-export-allowlist.json",
    "config/public-package.json",
    "hooks/hooks.json",
    "mcp/server.mjs",
    "mcp/tools.mjs",
    "schemas/brain-v9-*.json",
    "scripts/v9",
    "scripts/brain-lite-*.js",
    "scripts/package.json",
    "scripts/probe-v9-mcp.mjs",
    "scripts/package-selftest.js",
    "scripts/production-smoke.js",
    "scripts/test-contract.js",
    "scripts/check-contract.js",
    "scripts/build-public-export.js",
    "scripts/verify-v9-release.js",
    "evals/v9-reliability",
    "evals/codex-ab-v0.15",
    "docs/v9",
    "README.md",
    "assets/codex-brain-ip-hero.png",
    "assets/visual-provenance.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test-contract.js",
    "check": "node scripts/check-contract.js",
    "test:behavioral-memory": "node --test tests/brain-lite-behavioral-memory-*.test.js",
    "test:package": "node scripts/package-selftest.js",
    "eval:reliability": "node evals/v9-reliability/runner.cjs",
    "eval:ab": "node evals/codex-ab-v0.15/runner.cjs",
    "eval:ab:live": "node evals/codex-ab-v0.15/runner.cjs --live --confirm-paid",
    "mcp:probe": "node scripts/probe-v9-mcp.mjs",
    "smoke:production": "node scripts/production-smoke.js",
    "memory:v9:capabilities": "node scripts/v9/capability-verifier.js",
    "test:v9:memory": "node --test tests/brain-v9-memory-db.test.js tests/brain-v9-memory-service.test.js tests/brain-v9-memory-harness.test.js",
    "memory:capabilities": "node scripts/v9/capability-verifier.js",
    "memory:harness": "node bin/brain.js harness cycle"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "zod": "4.4.2"
  }
}
