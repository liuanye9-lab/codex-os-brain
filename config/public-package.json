    "releaseChannel": "personal",
    "compatibilityName": "codex-brain-v9"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "brain": "bin/brain.js",
    "codex-brain": "bin/brain.js"
  },
  "files": [
    "index.js",
    "core.js",
    ".mcp.json",
    ".agents/plugins/marketplace.json",
    ".codex-plugin/plugin.json",
    "bin/brain-lite.js",
    "bin/brain.js",
    "bin/brain-hook.js",
    "bin/run-brain-hook.js",
    "bin/package.json",
    "config/brain-lite-v8.json",
    "config/brain-lite-v9.json",
    "config/brain-lite.json",
    "config/public-export-allowlist.json",
    "config/public-package.json",
    "hooks/hooks.json",
    "mcp/server.mjs",
    "mcp/standalone.mjs",
    "mcp/tools.mjs",
    "schemas/brain-v9-*.json",
    "scripts/v9",
    "scripts/brain-lite-*.js",
    "scripts/package.json",
    "scripts/probe-v9-mcp.mjs",
    "scripts/package-selftest.js",
    "scripts/pack-install-smoke.js",
    "scripts/plugin-canary.js",
    "scripts/generate-sbom.js",
    "scripts/production-smoke.js",
    "scripts/test-contract.js",
    "scripts/check-contract.js",
    "scripts/build-public-export.js",
    "scripts/verify-v9-release.js",
    "evals/v9-reliability",
    "evals/codex-ab-v0.15",
    "examples/clarification-needed.json",
    "docs/v9",
    "docs/history/v7-heavy-harness.md",
    "v1/README.md",
    "README.md",
    "assets/codex-brain-ip-hero.png",
    "assets/visual-provenance.json",
