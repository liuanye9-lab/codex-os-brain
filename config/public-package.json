  "scripts": {
    "test": "node scripts/test-contract.js",
    "check": "node scripts/check-contract.js",
    "test:package": "node scripts/package-selftest.js",
    "test:pack-install": "node scripts/pack-install-smoke.js",
    "test:plugin-canary": "node scripts/plugin-canary.js",
