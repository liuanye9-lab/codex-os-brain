{
  "name": "codex-brain-v9",
  "version": "0.16.0",
  "description": "Codex Brain V10 reliability harness; V9 is the compatible runtime contract and cognitive assets remain an opt-in lab.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./labs/cognitive-assets": "./labs/cognitive-assets.js"
  },
  "codexBrain": {
    "productName": "Codex Brain",
    "productMajor": 10,
    "releaseVersion": "0.16.0",
    "runtimeContract": 9,
    "cognitiveAssetProtocol": 1,
    "releaseChannel": "research-preview",
    "compatibilityName": "codex-brain-v9"
  },
  "license": "MIT",
  "engines": { "node": ">=22.5" },
  "bin": {
    "brain": "bin/brain.js",
    "codex-brain": "bin/brain.js"
  },
  "files": [
    "index.js",
    "core.js",
    "labs/cognitive-assets.js",
    ".mcp.json",
    ".agents/plugins/marketplace.json",
    ".codex-plugin/plugin.json",
    "bin/brain-lite.js",
    "bin/brain.js",
    "bin/brain-hook.js",
    "bin/run-brain-hook.js",
    "bin/package.json",
    "config/brain-lite-v8.json",
    "config/brain-lite-v9.json",
    "config/brain-lite.json",
    "config/embedding-model-presets.json",
    "config/public-export-allowlist.json",
    "config/public-package.json",
    "hooks/hooks.json",
    "mcp/server.mjs",
    "mcp/standalone.mjs",
    "mcp/tools.mjs",
    "schemas/brain-v9-*.json",
    "scripts/v9",
    "scripts/brain-lite-*.js",
    "scripts/package.json",
    "scripts/probe-v9-mcp.mjs",
    "scripts/package-selftest.js",
    "scripts/pack-install-smoke.js",
    "scripts/plugin-canary.js",
    "scripts/generate-sbom.js",
    "scripts/npm-runtime.js",
    "scripts/production-smoke.js",
    "scripts/test-contract.js",
    "scripts/check-contract.js",
    "scripts/build-public-export.js",
    "scripts/verify-v9-release.js",
    "evals/v9-reliability",
    "evals/codex-ab-v0.15",
    "examples/clarification-needed.json",
    "docs/v9",
    "docs/history/v7-heavy-harness.md",
    "v1/README.md",
    "README.md",
    "assets/visual-provenance.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test-contract.js",
    "check": "node scripts/check-contract.js",
    "test:behavioral-memory": "node --test tests/brain-lite-behavioral-memory-*.test.js",
    "test:package": "node scripts/package-selftest.js",
    "test:pack-install": "node scripts/pack-install-smoke.js",
    "test:plugin-canary": "node scripts/plugin-canary.js",
    "sbom": "node scripts/generate-sbom.js",
    "eval:reliability": "node evals/v9-reliability/runner.cjs",
    "eval:replay-contract": "node evals/codex-ab-v0.15/runner.cjs",
    "eval:mechanism": "npm run eval:replay-contract",
    "eval:live-canary": "node evals/codex-ab-v0.15/runner.cjs --live --confirm-paid",
    "eval:ab": "npm run eval:mechanism",
    "eval:ab:live": "npm run eval:live-canary",
    "mcp:probe": "node scripts/probe-v9-mcp.mjs",
    "smoke:production": "node scripts/production-smoke.js",
    "memory:v9:capabilities": "node scripts/v9/capability-verifier.js",
    "test:v9:memory": "node --test tests/brain-v9-memory-db.test.js tests/brain-v9-memory-service.test.js tests/brain-v9-memory-harness.test.js",
    "memory:capabilities": "node scripts/v9/capability-verifier.js",
    "memory:harness": "node bin/brain.js harness cycle"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "zod": "4.4.2"
  }
}
