{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuanye9-lab/codex-os-brain/schemas/brain-v9-cognitive-asset.schema.json",
  "title": "Codex Brain Cognitive Asset Protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/CognitiveSourceEnvelope" },
    { "$ref": "#/$defs/EvidenceAssertion" },
    { "$ref": "#/$defs/CognitionUnit" },
    { "$ref": "#/$defs/PlaybookAsset" },
    { "$ref": "#/$defs/KnowledgeBaseAsset" },
    { "$ref": "#/$defs/AgentProfileAsset" },
    { "$ref": "#/$defs/ReuseReceipt" },
    { "$ref": "#/$defs/AssetProjectionGrant" }
  ],
  "$defs": {
    "ProtocolVersion": {
      "const": "cognitive-asset-v1"
    },
    "CognitiveSourceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "sourceId",
        "captureMode",
        "sourceHash",
        "trustStatus",
        "privacyLevel",
        "subjects",
        "allowedUses",
        "retentionPolicy",
        "version"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "sourceId": { "type": "string", "minLength": 1 },
        "captureMode": { "enum": ["guided_interview", "harness_trajectory", "daily", "import"] },
        "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "trustStatus": { "enum": ["trusted", "untrusted", "quarantined", "revoked"] },
        "privacyLevel": { "enum": ["local_only", "private", "restricted", "public"] },
        "subjects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "allowedUses": {
          "type": "array",
          "items": { "enum": ["evidence_extraction", "recall", "playbook_compile", "knowledge_compile", "projection"] },
          "uniqueItems": true
        },
        "retentionPolicy": { "type": "object" },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validTo": { "type": ["string", "null"], "format": "date-time" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "EvidenceAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "evidenceId",
        "sourceId",
        "sourceVersion",
        "epistemicType",
        "anchorRef",
        "anchorStatus",
        "attributionStatus",
        "entailmentStatus",
        "externalFactStatus",
        "uncertainty"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "evidenceId": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "epistemicType": {
          "enum": ["source_fact", "speaker_claim", "user_experience", "synthesis_inference", "project_application"]
        },
        "anchorRef": { "type": "object" },
        "anchorStatus": { "enum": ["unverified", "verified", "failed"] },
        "attributionStatus": { "enum": ["not_applicable", "unverified", "verified", "failed"] },
        "entailmentStatus": { "enum": ["unverified", "verified", "failed"] },
        "externalFactStatus": { "enum": ["not_applicable", "unverified", "verified", "failed"] },
        "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "CognitionUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "unitId",
        "claim",
        "cognitionType",
        "context",
        "mechanism",
        "boundary",
        "falsifier",
        "counterexample",
        "transferScope",
        "evidenceDependencies",
        "status",
        "privacyLevel",
        "sensitiveInference",
        "version"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "unitId": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "cognitionType": { "type": "string", "minLength": 1 },
        "context": { "type": "object" },
        "mechanism": { "type": "object" },
        "boundary": { "type": "string" },
        "falsifier": { "type": "string" },
        "counterexample": { "type": "string" },
        "transferScope": { "type": "object" },
        "evidenceDependencies": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "status": { "enum": ["candidate", "confirmed", "rejected", "retired", "stale_blocked"] },
        "privacyLevel": { "enum": ["local_only", "private", "restricted", "public"] },
        "sensitiveInference": { "type": "boolean" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "PlaybookAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "playbookId",
        "name",
        "targetProblem",
        "manifest",
        "evidenceDependencies",
        "dependencyDigest",
        "semanticMaturity",
        "deploymentState",
        "validationStatus",
        "privacyLevel",
        "version"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "playbookId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "targetProblem": { "type": "string", "minLength": 1 },
        "manifest": { "type": "object" },
        "evidenceDependencies": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "dependencyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "semanticMaturity": { "enum": ["method_candidate", "runnable_playbook", "verified_capability"] },
        "deploymentState": { "enum": ["candidate", "shadow", "replay", "canary", "promoted", "revoked"] },
        "validationStatus": { "enum": ["current", "stale_blocked", "revoked"] },
        "privacyLevel": { "enum": ["local_only", "private", "restricted", "public"] },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "KnowledgeBaseAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion", "knowledgeBaseId", "name", "domain", "description", "cognitionUnitIds",
        "playbookIds", "retrievalPolicy", "dependencyDigest", "status", "privacyLevel", "version"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "knowledgeBaseId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "domain": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "maxLength": 1000 },
        "cognitionUnitIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 100, "uniqueItems": true },
        "playbookIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 50, "uniqueItems": true },
        "retrievalPolicy": { "type": "object" },
        "dependencyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "enum": ["draft", "published", "stale_blocked", "revoked"] },
        "privacyLevel": { "enum": ["local_only", "private", "restricted", "public"] },
        "version": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AgentProfileAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion", "agentId", "name", "purpose", "knowledgeBaseIds", "playbookIds", "toolRefs",
        "dependencyRefs", "contextBudgetTokens", "dependencyDigest", "readinessStatus", "deploymentState", "version"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "agentId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "knowledgeBaseIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 20, "uniqueItems": true },
        "playbookIds": { "type": "array", "items": { "type": "string" }, "maxItems": 30, "uniqueItems": true },
        "toolRefs": { "type": "array", "items": { "type": "string" }, "maxItems": 50, "uniqueItems": true },
        "dependencyRefs": { "type": "array", "maxItems": 100 },
        "contextBudgetTokens": { "type": "integer", "minimum": 100, "maximum": 100000 },
        "dependencyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "readinessStatus": { "enum": ["draft", "ready", "stale_blocked", "revoked"] },
        "deploymentState": { "enum": ["draft", "shadow", "canary", "active", "revoked"] },
        "version": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ReuseReceipt": {
      "type": "object",
      "required": [
        "protocolVersion",
        "receiptId",
        "playbookId",
        "playbookVersion",
        "contextHash",
        "semanticCaseHash",
        "outcome",
        "caseKind",
        "verifierIdentity",
        "executorIdentity",
        "productionPath"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "receiptId": { "type": "string", "minLength": 1 },
        "playbookId": { "type": "string", "minLength": 1 },
        "playbookVersion": { "type": "integer", "minimum": 1 },
        "contextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "semanticCaseHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "outcome": { "enum": ["success", "failure", "not_applicable", "infrastructure_failure"] },
        "caseKind": { "enum": ["ordinary", "boundary", "adversarial"] },
        "verifierIdentity": { "type": "string", "minLength": 1 },
        "executorIdentity": { "type": "string", "minLength": 1 },
        "criticalSafetyFailure": { "type": "boolean" },
        "productionPath": { "const": true }
      }
    },
    "AssetProjectionGrant": {
      "type": "object",
      "required": [
        "protocolVersion",
        "grantId",
        "recipientAgent",
        "purpose",
        "expiresAt",
        "contentVersion",
        "policyDigest",
        "noOnwardSharing"
      ],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/ProtocolVersion" },
        "grantId": { "type": "string", "minLength": 1 },
        "recipientAgent": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "contentVersion": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "noOnwardSharing": { "const": true }
      }
    }
  }
}
