{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-brain/brain-v9-task-contract.schema.json",
  "title": "Codex Brain V9 Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "taskId", "objective", "lifecycle", "constraints", "scope", "criteria", "unresolved", "risk", "executionMode", "externalWrite", "compactionGeneration", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 9 },
    "revision": { "type": "integer", "minimum": 1 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "taskFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "lifecycle": { "enum": ["active", "blocked", "complete", "abandoned"] },
    "constraints": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source", "explicit"],
        "properties": {
          "id": { "type": "string", "maxLength": 160 }, "text": { "type": "string", "maxLength": 4000 },
          "source": { "enum": ["user", "project", "policy", "inference"] }, "explicit": { "type": "boolean" }
        }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["allowed", "forbidden"],
      "properties": { "allowed": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 4096 } }, "forbidden": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 4096 } } }
    },
    "criteria": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "required", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 }, "required": { "type": "boolean" },
          "verifier": { "enum": ["command_exit_0", "command", "test_runner", "tests", "git_diff_bounded", "scope", "human_attestation", "human", "file_exists"] },
          "verifierSpec": { "type": "object" },
          "status": { "enum": ["pending", "passed", "failed", "unverified", "waived"] },
          "lastVerifiedAt": { "type": ["string", "null"] },
          "lastVerifierFingerprint": { "type": ["string", "null"] },
          "harnessVerified": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
        }
      }
    },
    "unresolved": { "type": "array", "items": { "type": "string" } },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "executionMode": { "enum": ["read_only", "write"] },
    "externalWrite": { "type": "boolean" },
    "compactionGeneration": { "type": "integer", "minimum": 0 },
    "lastVerifiedAt": { "type": ["string", "null"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "specHash", "sealedAt", "seal"],
      "properties": {
        "version": { "const": 1 },
        "specHash": { "type": "string" },
        "sealedAt": { "type": "string", "format": "date-time" },
        "seal": { "type": "string" }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "provenance"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["passed", "failed", "unverified"] },
        "harnessVerified": { "type": "boolean" },
        "fingerprint": { "type": ["string", "null"] },
        "seal": { "type": ["string", "null"] },
        "verifiedAt": { "type": ["string", "null"] },
        "summary": {},
        "provenance": {
          "type": "object",
          "required": ["kind", "ref"],
          "properties": { "kind": { "type": "string" }, "ref": { "type": "string" } },
          "additionalProperties": false
        }
      }
    }
  }
}
